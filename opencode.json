{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true,
      "environment": {
        "BROWSER": "chromium"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "lighthouse": {
      "type": "local",
      "command": ["npx", "-y", "mcp-server-lighthouse"],
      "enabled": true
    }
  },
  "formatter": {
    "biome": {
      "command": ["npx", "-y", "@biomejs/biome@latest", "format", "--stdin-file-path", "$FILE"],
      "extensions": [".js", ".jsx", ".ts", ".tsx", ".json", ".jsonc", ".css"]
    }
  }
}
