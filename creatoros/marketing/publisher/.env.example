# Copy to .env and fill in. Get these from Google Cloud Console:
#   1. Create a project, enable "YouTube Data API v3"
#   2. OAuth consent screen -> External -> add your Google account as a Test user
#   3. Credentials -> Create credentials -> OAuth client ID -> type "Desktop app"
#   4. Paste the Client ID + Client secret below
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret

# Optional: local port for the OAuth redirect (default 4571)
# YOUTUBE_REDIRECT_PORT=4571

# Facebook Page publishing (marketing/publisher/facebook.mjs)
# See docs/FACEBOOK-SETUP.md for how to obtain a long-lived Page access token.
FB_PAGE_ID=61595342349784
FB_PAGE_TOKEN=your-long-lived-page-access-token
# Optional: Graph API version (default v23.0)
# FB_GRAPH_VERSION=v23.0
