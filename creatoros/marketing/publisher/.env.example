# Copy to .env and fill in. Get these from Google Cloud Console:
#   1. Create a project, enable "YouTube Data API v3"
#   2. OAuth consent screen -> External -> add your Google account as a Test user
#   3. Credentials -> Create credentials -> OAuth client ID -> type "Desktop app"
#   4. Paste the Client ID + Client secret below
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret

# Optional: local port for the OAuth redirect (default 4571)
# YOUTUBE_REDIRECT_PORT=4571

# Optional but recommended: the channel uploads must land on. A Google account
# can own a personal channel plus brand channels; the OAuth chooser defaults to
# the personal one, so without this the `auth` command cannot warn you.
# YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
# Optional: Google account that owns that channel, used as the OAuth login_hint.
# YOUTUBE_LOGIN_HINT=you@example.com
#
# Important: an OAuth app left in "Testing" expires refresh tokens after 7 days.
# Publish the consent screen (External -> Publish app) so scheduled posting does
# not break every week.

# Facebook Page publishing (marketing/publisher/facebook.mjs)
# See docs/FACEBOOK-SETUP.md for how to obtain a long-lived Page access token.
FB_PAGE_ID=1299369053270317
FB_PAGE_TOKEN=your-long-lived-page-access-token
# Optional: Graph API version (default v23.0)
# FB_GRAPH_VERSION=v23.0

# Instagram Reels publishing (marketing/publisher/instagram.mjs)
# Requires an Instagram Business/Creator account linked to a Facebook Page, and a
# token with instagram_basic + instagram_content_publish + pages_show_list.
# Instagram pulls the video from a public URL, so IG_PUBLIC_BASE_URL must serve
# the rendered clips over the internet.
IG_USER_ID=17841400000000000
IG_ACCESS_TOKEN=your-long-lived-page-graph-token
IG_PUBLIC_BASE_URL=https://usecreatoros.co/social
# Optional: Graph API version (default v23.0)
# IG_GRAPH_VERSION=v23.0

# TikTok publishing (marketing/publisher/tiktok.mjs)
# Requires a user access token with the video.publish scope and a verified
# PULL_FROM_URL domain (also served over the internet).
TIKTOK_ACCESS_TOKEN=your-tiktok-user-access-token
TIKTOK_PUBLIC_BASE_URL=https://usecreatoros.co/social
# Optional: TIKTOK_OPEN_ID=..., TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE, TIKTOK_API_VERSION=v2

# LinkedIn Company Page publishing (marketing/publisher/linkedin.mjs)
# Requires a 3-legged OAuth token from a Page admin with the
# w_organization_social + r_organization_social scopes (app must be approved).
LINKEDIN_ACCESS_TOKEN=your-linkedin-oauth-token
LINKEDIN_ORG_ID=144019338
# Optional: LINKEDIN_API_VERSION=202401, LINKEDIN_PUBLIC_BASE_URL=https://usecreatoros.co/social
