# Core
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=data/creatoros.db

# Admin (comma separated emails)
ADMIN_EMAILS=

# AI (OpenAI compatible)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Email provider (see src/lib/email/mailer.ts)
# EMAIL_PROVIDER=log | resend | mailgun | brevo
EMAIL_PROVIDER=log
EMAIL_FROM=no-reply@creatoros.dev
EMAIL_FROM_NAME=CreatorOS
# Resend (EMAIL_PROVIDER=resend)
RESEND_API_KEY=
# Mailgun (EMAIL_PROVIDER=mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Brevo / ex-Sendinblue (EMAIL_PROVIDER=brevo)
BREVO_API_KEY=

# Optional: custom SMTP (not used yet - log/resend/mailgun take precedence)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Stripe (optional - enable billing when set)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Payment provider fallback: stripe | cashfree | mock (mock = dev only, instant fake paid)
PAYMENT_PROVIDER=

# Cashfree (optional - enable billing when set)
# CASHFREE_CLIENT_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_ENV=sandbox | live
# CASHFREE_API_VERSION=2025-01-01
CASHFREE_CLIENT_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01

# Dodo Payments (optional - Merchant of Record for US/UK/international sales)
# Enable by setting PAYMENT_PROVIDER=dodo and DODO_PAYMENTS_API_KEY. Products
# must exist in the Dodo dashboard first; map each plan to its product id:
#   starter/creator/pro/business -> DODO_PRODUCT_STARTER / _CREATOR / _PRO / _BUSINESS
# See docs/PAYMENTS-DODO.md for the full setup.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# test (default, https://test.dodopayments.com) | live
DODO_ENV=test
# Currencies this Dodo account can settle (comma separated). INR is normally
# left to Cashfree; Dodo is used for USD/GBP/EUR here.
DODO_CURRENCIES=usd,gbp,eur
DODO_PRODUCT_STARTER=
DODO_PRODUCT_CREATOR=
DODO_PRODUCT_PRO=
DODO_PRODUCT_BUSINESS=

# Currency for plan upgrades. Cashfree supports both, so this is a merchant
# choice: usd (default) or inr. Changing it also changes the price shown.
BILLING_CURRENCY=usd

# Feature flags
FEATURE_BOOKING=true
FEATURE_AI=true

# --- Production deployment (Render / Docker) ---
# The Dockerfile & entrypoint run schema migrations on boot, so a fresh MySQL-like
# persistence just works. Point DATABASE_PATH at the mounted volume:
#   Render:   DATABASE_PATH=/data/creatoros.db  (disk created by render.yaml)
#   Docker:   DATABASE_PATH=/data/creatoros.db  (volume in docker-compose.yml)
# Health check endpoint: GET /api/health
#
# Stripe in production:
#   1. Create webhook in Stripe dashboard -> API keys -> Webhooks
#      Endpoint: https://<your-domain>/api/webhooks/stripe
#      Events:  checkout.session.completed
#               customer.subscription.created
#               customer.subscription.updated
#               customer.subscription.deleted
#   2. Put the webhook signing secret in STRIPE_WEBHOOK_SECRET
#   3. Set STRIPE_SECRET_KEY / STRIPE_PUBLISHABLE_KEY (sk_live/pk_live for prod)
#      and NEXT_PUBLIC_SITE_URL=https://<your-domain>